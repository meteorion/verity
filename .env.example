# ============================================================
# Verity 环境变量模板
# 复制为 .env 并填入真实值后启动服务
# ============================================================

# ---- LLM ----
# P1 生成节点直连通义千问（DashScope OpenAI 兼容模式），见 app/inference/llm.py；
# 网关方案（LiteLLM vs 直连 SDK）仍待确认，见 doc/plan.md §3.11。
QWEN_API_KEY=                              # 必填，DashScope API Key，generate_node 依赖它
LLM_MODEL=qwen-plus
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

ANTHROPIC_API_KEY=sk-ant-xxxx               # P2 网关备用模型，见 config/litellm.yaml
OPENAI_API_KEY=sk-xxxx                     # P2 网关备用模型（fallback）

# ---- 数据库 ----
POSTGRES_USER=raguser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ragdb
PGVECTOR_DSN=postgresql://raguser:changeme@postgres:5432/ragdb

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- 本地存储 ----
STORAGE_ROOT=/data/rag

# ---- 模型路径（容器内路径） ----
# P1 默认：sentence-transformers 本地小模型（HF hub id，首次启动自动下载到 HF 缓存，CPU 可跑）。
# 未经 P0 正式 benchmark 选型（doc/plan.md §3.2），效果达标后可能替换，embedding.py 已做成可插拔 backend。
EMBEDDING_MODEL_PATH=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RERANK_MODEL_PATH=/models/bge-reranker-v2-m3
NLI_MODEL_PATH=/models/chinese-roberta-nli

# ---- P2 能力开关（P1 默认 false：不装依赖、不下载模型也能启动，见 doc/plan.md §3.3/§3.8） ----
ENABLE_RERANK=false
ENABLE_NLI=false

# ---- FAQ 精准匹配（P1 进程内索引，见 doc/plan.md §3.13） ----
FAQ_INDEX_PATH=/data/rag/faq/faq.json

# ---- 推理阈值（P0 阶段实测后填入） ----
RERANK_THRESHOLD=0.38
SEMANTIC_CACHE_THRESHOLD=0.93

# ---- LiteLLM 网关 ----
LITELLM_CONFIG_PATH=/app/config/litellm.yaml
LITELLM_MASTER_KEY=sk-litellm-changeme

# ---- Langfuse 可观测 ----
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=http://langfuse:3000

# ---- 安全过滤 ----
SAFETY_BLOCKLIST=                          # P1 本地敏感词，逗号分隔（见 doc/plan.md §3.9），留空=不拦截
SAFETY_API_KEY=                            # 阿里云内容安全 AppKey，P2+ 视红队结果决定是否叠加

# ---- Prompt 版本 ----
PROMPT_VERSION=v1.0.0

# ---- JWT ----
JWT_SECRET=changeme-jwt-secret
JWT_ALGORITHM=HS256

# ---- 应用端口 ----
APP_PORT=8000
