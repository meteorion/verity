# ============================================================
# Verity 环境变量模板
# 复制为 .env 并填入真实值后启动服务
#
# 快速验证（无 GPU）：保持下方「推理提供者」的默认值（api/none/none/anthropic）
# 生产部署（有 GPU）：将各 PROVIDER 改为 local，并填入模型路径
# ============================================================

# ---- LLM ----
ANTHROPIC_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=sk-xxxx                     # embedding API 或 LLM fallback

# ---- 推理提供者 ————————————————————————————————————————
# EMBEDDING_PROVIDER: api | local
#   api   → OpenAI-compatible API（无需 GPU，无需下载模型）
#   local → BGE-M3 进程内加载（需 GPU 或 CPU 量化，~2 GB）
EMBEDDING_PROVIDER=api
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_API_KEY=                         # 留空则使用 OPENAI_API_KEY
EMBEDDING_MODEL=text-embedding-3-small

# RERANK_PROVIDER: none | local
#   none  → 跳过精排，直接使用 RRF 顺序（P0/P1 快速验证）
#   local → BGE-Reranker-v2-m3（需 GPU，~1.5 GB）
RERANK_PROVIDER=none

# NLI_PROVIDER: none | local
#   none  → 跳过引用一致性校验（P0/P1 阶段默认）
#   local → chinese-roberta-nli 异步 CPU 校验
NLI_PROVIDER=none

# LLM_PROVIDER: anthropic | litellm
#   anthropic → 直接调用 Anthropic SDK（无需 LiteLLM 容器）
#   litellm   → 通过 LiteLLM 网关（需 --profile obs 启动）
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2
# LLM_PROVIDER=openai 时有效（DashScope / SiliconFlow 等 OpenAI 兼容服务）
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=                               # 留空则使用 OPENAI_API_KEY
# ————————————————————————————————————————————————————————

# ---- 数据库 ----
POSTGRES_USER=raguser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ragdb
PGVECTOR_DSN=postgresql://raguser:changeme@postgres:5432/ragdb

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- 本地存储 ----
STORAGE_ROOT=/data/rag

# ---- 模型路径（容器内路径，仅 PROVIDER=local 时生效） ----
EMBEDDING_MODEL_PATH=/models/bge-m3
RERANK_MODEL_PATH=/models/bge-reranker-v2-m3
NLI_MODEL_PATH=/models/chinese-roberta-nli

# ---- 检索参数 ----
RETRIEVAL_TOP_VECTOR=50                    # 每路候选数
RETRIEVAL_TOP_K=6                          # 最终返回数
RERANK_THRESHOLD=0.38                      # 仅 RERANK_PROVIDER=local 时有效（需 P0 标定）
SEMANTIC_CACHE_THRESHOLD=0.93

# ---- LiteLLM 网关（仅 LLM_PROVIDER=litellm 或 --profile obs 时需要） ----
LITELLM_URL=http://litellm:4000
LITELLM_CONFIG_PATH=/app/config/litellm.yaml
LITELLM_MASTER_KEY=sk-litellm-changeme

# ---- Langfuse 可观测（仅 --profile obs 时需要） ----
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=http://langfuse:3000

# ---- 安全过滤 ----
SAFETY_API_KEY=                            # 阿里云内容安全 AppKey

# ---- Prompt ----
PROMPT_VERSION=v1.0.0
# 留空则使用容器内默认路径 /app/prompts/system_prompt.txt
# SYSTEM_PROMPT_PATH=/app/prompts/system_prompt.txt

# ---- JWT ----
JWT_SECRET=changeme-jwt-secret
JWT_ALGORITHM=HS256
# 仅当服务部署在已完成鉴权、由网关设置 X-UID/X-Roles 的可信内网时才设为 true。
# 默认 false：/v1/chat 的身份与角色只从已验证的 JWT 中获取，忽略请求头，防止越权。
TRUST_FORWARDED_IDENTITY=false

# ---- 应用启动 ----
APP_PORT=8000
# API 模式约 10s；Local 模式约 90s（等待模型加载）
APP_START_PERIOD=30s
